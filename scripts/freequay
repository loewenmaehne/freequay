#!/bin/zsh
# Freequay: launcher for the Wine build from CodeWeavers' CrossOver 26.3.0 sources.
#
#   freequay new <bottle>                          create a bottle
#   freequay run <bottle> [options] <exe> [args]   start a Windows program, a shortcut (.lnk) or a
#                                                   Steam game (steam:ID)
#   freequay wine <bottle> <program> [args]        start a Wine program (winecfg, regedit, cmd ...)
#   freequay set <bottle> <key> <value>            change a bottle default
#   freequay app <bottle> [<program.exe> <backend|->]  set, delete or show graphics per program
#   freequay rule <bottle> <key> <directive...|->  add or delete a rule of the bottle
#   freequay info [<bottle>] <program.exe|steam:ID|title>  show all rules for a program
#   freequay fix <bottle> [--list] [steam:ID ...]  one-time setup from the rules (winetricks,
#                                                   registry, Windows version); all Steam games
#                                                   without an ID
#   freequay kill <bottle>                         stop all processes of the bottle
#   freequay list                                  list bottles
#   freequay programs <bottle> [<program> [-]]     list what run can start: Steam, its games, the
#                                                   shortcuts in the Start menu and on the desktop
#                                                   and the programs added here; add one, or take
#                                                   one off the list with -
#   freequay applegamingwiki [<bottle>...]         look up the rules from AppleGamingWiki for the
#                                                   installed Steam games now; run and programs do
#                                                   it by themselves, each game at most once a week
#
# Options for run (override the bottle defaults):
#   --backend d3dmetal|d3dmetal3|dxmt|dxvk|wined3d   graphics for all programs without a rule
#                                                   (default: dxmt); Direct3D 12 programs get
#                                                   d3dmetal or wined3d instead of dxmt and dxvk
#   --avx                             Rosetta reports AVX/AVX2 to the game
#   --hud                             show the Metal performance HUD
#   --debug                           keep Wine's debug output
set -euo pipefail

ROOT=${0:A:h:h}
WINE_DIR=$ROOT/dist/wine
BACKENDS=$ROOT/dist/backends
DATA="$HOME/Library/Application Support/freequay"
BOTTLES=$DATA/Bottles
# What Freequay downloads or installs by itself goes to DATA as well, so that Freequay.app stays as
# it was signed: D3DMetal from Apple's download (backends), Wine Mono from WineHQ (cache/wine, where
# Wine looks with XDG_CACHE_HOME), winetricks and the packages it downloads (cache).
OWN_BACKENDS=$DATA/backends
CACHE=$DATA/cache

# Rules per program: the open counterpart of CrossOver's closed cxcompatdb. ntdll reads them
# from these files whenever a program starts (patches/0005, format in compat/README.md); for
# every setting the first file that has it wins. The bottle's own rules come first.
# AppleGamingWiki's content is under CC BY-NC-SA 3.0, which allows no commercial use, so its
# rules are not part of Freequay: scripts/compat/applegamingwiki looks up the Steam games
# installed here and writes their rules into AGW_DIR, outside the Freequay folder.
COMPAT=$ROOT/compat
AGW_DIR=$DATA/compat
AGW=$ROOT/scripts/compat/applegamingwiki
COMPAT_FILES=($COMPAT/manual.txt $AGW_DIR/applegamingwiki.txt $COMPAT/protonfixes.txt $COMPAT/proton.txt
  $COMPAT/protondb.txt $COMPAT/dxvk.txt)
WINETRICKS=$CACHE/winetricks-20260125
[[ ! -f $ROOT/downloads/compat/${WINETRICKS:t} ]] || WINETRICKS=$ROOT/downloads/compat/${WINETRICKS:t}  # a build tree

die() { print -u2 -- "freequay: $*"; exit 1; }

bottle_dir() {
  [[ -n "${1:-}" ]] || die "bottle name missing"
  print -r -- "$BOTTLES/$1"
}

conf_get() { # bottle-dir key default
  local f="$1/freequay.conf" v=""
  [[ -f $f ]] && v=$(sed -n "s/^$2=//p" "$f" | tail -1)
  print -r -- "${v:-$3}"
}

conf_set() { # bottle-dir key value
  local f="$1/freequay.conf"
  touch "$f"
  sed -i '' "/^$2=/d" "$f"
  print -r -- "$2=$3" >> "$f"
}

check_backend() {
  [[ $1 == (d3dmetal|d3dmetal3|dxmt|dxvk|wined3d) ]] || die "unknown backend: $1"
}

backend_dir() { # backend -> DLL directory; wined3d is Wine's own d3d and has none
  case $1 in
    # from Apple's download, installed into DATA; a build tree may keep them in dist/backends
    d3dmetal|d3dmetal3) [[ -d $OWN_BACKENDS/$1 ]] && print -r -- "$OWN_BACKENDS/$1/lib/wine" || print -r -- "$BACKENDS/$1/lib/wine" ;;
    dxmt|dxvk) print -r -- "$BACKENDS/$1" ;;
  esac
}

compat_files() { # bottle-dir -> rule files, separated by colons
  local f out="$1/compat.txt"
  for f in $COMPAT_FILES; do out+=":$f"; done
  print -r -- "$out"
}

# The rules from AppleGamingWiki, game by game: a Steam game is looked up when it is new or its
# lookup is a week old, with two requests to AppleGamingWiki. Without network nothing changes, the
# game starts without these rules and the next start tries again; after other errors the next try
# waits an hour. FREEQUAY_OFFLINE=1 (set by the app until its note on downloads was read) skips
# the lookups.
steam_ids() { # bottle-dir -> app IDs of the installed Steam games
  local f id
  for f in "$1/drive_c/Program Files (x86)/Steam"/steamapps/appmanifest_<->.acf(N); do
    id=${${f:t:r}#appmanifest_}
    [[ $id == 228980 ]] || print -r -- $id  # Steamworks Common Redistributables
  done
}

agw_due() { # app IDs -> those never looked up or looked up a week ago or longer
  local games=$AGW_DIR/applegamingwiki/games.tsv week=$(date -v-7d +%Y-%m-%d) id date rest
  local -A seen
  if [[ -f $games ]]; then
    while IFS=$'\t' read -r id date rest; do [[ $id == \#* ]] || seen[$id]=$date; done < "$games"
  fi
  for id in "$@"; do [[ ${seen[$id]:-} > $week ]] || print -r -- $id; done
}

agw_lookup() { # [--quick|--background] app IDs: rules again after an update, then the games due
  local mode= failed=$AGW_DIR/applegamingwiki/.failed ids
  [[ ${1:-} == --(quick|background) ]] && { mode=$1; shift; }
  [[ -x $AGW && -z ${FREEQUAY_OFFLINE:-} ]] || return 0
  ids=($(agw_due "$@"))
  [[ ! -f $failed ]] || (( $(date +%s) - $(stat -f %m "$failed") > 3600 )) || ids=()
  mkdir -p "$AGW_DIR/applegamingwiki"
  if [[ $mode == --background ]]; then
    agw_stale || (( $#ids )) || return 0
    nohup /bin/zsh "$ROOT/scripts/freequay" applegamingwiki --ids ${(u)ids} < /dev/null \
      >> "$AGW_DIR/applegamingwiki.log" 2>&1 &!
  else
    agw_refresh
    (( $#ids )) || return 0
    agw_run ${mode:+--quick} ${(u)ids} >> "$AGW_DIR/applegamingwiki.log" 2>&1
  fi
}

agw_run() { # [--quick] app IDs: the lookup itself
  local ret=0 quick=()
  [[ ${1:-} == --quick ]] && { quick=(--quick); shift; }
  mkdir -p "$AGW_DIR/applegamingwiki"
  "$AGW" lookup $quick "$AGW_DIR" "$@" || ret=$?
  # 3: no network, 4: another lookup runs; after other errors the next try waits an hour
  (( ret == 0 || ret == 3 || ret == 4 )) || touch "$AGW_DIR/applegamingwiki/.failed"
  (( ret != 0 )) || agw_made_by > "$AGW_DIR/applegamingwiki/made-by"
  return $ret
}

agw_made_by() { print -r -- "$(head -1 "$ROOT/VERSION" 2> /dev/null) $(cksum < "$AGW")"; }

agw_stale() { # were the rules written by another version of Freequay?
  local made=$AGW_DIR/applegamingwiki/made-by
  [[ -f $AGW_DIR/applegamingwiki/games.tsv ]] || return 1
  [[ ! -f $made || "$(<$made)" != "$(agw_made_by)" ]]
}

agw_refresh() { # after an update of Freequay, write the rules again from the pages kept
  agw_stale || return 0
  if "$AGW" rules "$AGW_DIR" >> "$AGW_DIR/applegamingwiki.log" 2>&1; then
    agw_made_by > "$AGW_DIR/applegamingwiki/made-by"
  fi
}

agw_watch() { # bottle-dir: while Steam runs there, look up the games it installs meanwhile
  local pid=$AGW_DIR/applegamingwiki/watch-${1:t}.pid
  [[ -x $AGW && -z ${FREEQUAY_OFFLINE:-} ]] || return 0
  [[ -f $pid ]] && kill -0 "$(<$pid)" 2> /dev/null && return 0
  mkdir -p "${pid:h}"
  nohup /bin/zsh "$ROOT/scripts/freequay" applegamingwiki --watch "${1:t}" < /dev/null >> "$AGW_DIR/applegamingwiki.log" 2>&1 &!
}

rule_key() { # program.exe or steam:ID -> key of a rule
  case $1 in
    steam:<->) print -r -- "$1" ;;
    exe:?*) print -r -- "$1" ;;
    *[$'\t'=\;]*|"") die "invalid program: $1" ;;
    *) print -r -- "exe:$1" ;;
  esac
}

rule_del() { # bottle-dir key [directive]: delete the rules of a key, only those with this directive
  local f="$1/compat.txt"
  [[ -f $f ]] || return 0
  KEY="$2" DIR="${3:-}" awk -F'\t' '$1 != ENVIRON["KEY"] || (ENVIRON["DIR"] != "" && $0 !~ ("\t" ENVIRON["DIR"] "="))' "$f" > "$f.tmp"
  mv "$f.tmp" "$f"
}

line_del() { # file line: delete every copy of that exact line
  [[ -f $1 ]] || return 0
  LINE="$2" awk '$0 != ENVIRON["LINE"]' "$1" > "$1.tmp"
  mv "$1.tmp" "$1"
}

# What a bottle can start without being added: Steam, its installed games and the shortcuts
# installers put into the Start menu and on the desktop, one name and run target per line.
# Shortcuts (.lnk) start their program through Wine's start.exe; Steam's own shortcut and
# uninstallers are left out.
found_programs() { # bottle-dir
  local steam="$1/drive_c/Program Files (x86)/Steam" f id name
  [[ -f $steam/steam.exe ]] && print -r -- "Steam"$'\t'"$steam/steam.exe"
  for f in "$steam"/steamapps/appmanifest_<->.acf(N); do
    id=${${f:t:r}#appmanifest_}
    [[ $id != 228980 ]] || continue  # Steamworks Common Redistributables, not a game
    name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$f" | head -1)
    print -r -- "${name:-steam:$id}"$'\t'"steam:$id"
  done | sort -f
  for f in "$1"/drive_c/{ProgramData,users/*/AppData/Roaming}/Microsoft/Windows/Start\ Menu/Programs/**/*.lnk(N) \
      "$1"/drive_c/users/*/Desktop/*.lnk(N); do
    [[ ${f:t:r:l} == (steam|*uninstall*) ]] || print -r -- "${f:t:r}"$'\t'"$f"
  done | sort -f -u -t$'\t' -k1,1
}

bottle_running() { # bottle-dir: is a wineserver running for the bottle?
  local id
  id=$(printf 'server-%x-%x' $(stat -f '%d %i' "$1"))
  [[ -S /tmp/.wine-$UID/$id/socket ]]
}

# One-time setup from the rules (scripts/compat/fix, built from fix.swift). winetricks waits until
# every program of the bottle has ended, so this only runs when nothing runs there. Its cabextract
# is scripts/compat/cabextract, which unpacks with the bsdtar of macOS.
run_fix() { # bottle-dir [--list] [key ...]
  local dir=$1; shift
  [[ -x $ROOT/scripts/compat/fix ]] || die "scripts/compat/fix is missing, build it with scripts/build-app.sh"
  setup_env "$dir" "$(conf_get "$dir" backend dxmt)" 0 0 0
  if [[ ! -f $WINETRICKS ]]; then
    mkdir -p "${WINETRICKS:h}"
    curl -sfL -o "$WINETRICKS" "https://raw.githubusercontent.com/Winetricks/winetricks/${WINETRICKS##*-}/src/winetricks" ||
      die "could not download winetricks"
  fi
  if [[ ${1:-} != --list ]] && bottle_running "$dir"; then
    die "programs are still running in the bottle; stop them first (freequay kill ${dir:t})"
  fi
  PATH="$ROOT/scripts/compat:$PATH" "$ROOT/scripts/compat/fix" "$dir" "$WINE_DIR/bin/wine" "$WINETRICKS" \
    "$FREEQUAY_COMPAT_FILES" "$@"
}

setup_env() { # bottle-dir backend avx hud debug
  local dir=$1 backend=$2 b d
  export WINEPREFIX="$dir"
  export DYLD_FALLBACK_LIBRARY_PATH="$ROOT/deps/lib:/usr/lib"
  export FREEQUAY_LIBRARY_PATH=$DYLD_FALLBACK_LIBRARY_PATH  # survives system binaries (fix)
  export XDG_CACHE_HOME=$CACHE  # Wine Mono
  export WINEMSYNC=1
  export MVK_CONFIG_LOG_LEVEL=${MVK_CONFIG_LOG_LEVEL:-1}
  [[ $5 == 1 ]] || export WINEDEBUG=${WINEDEBUG:--all}
  check_backend "$backend"
  d=$(backend_dir "$backend")
  case $backend in
    # d3dmetal = Apple's D3DMetal 4.0 beta 2, d3dmetal3 = 3.0 (scripts/install-d3dmetal.sh)
    d3dmetal|d3dmetal3) [[ -d $d ]] || die "$backend is missing: add D3DMetal in the app, or run scripts/install-d3dmetal.sh" ;;
    dxmt) [[ -d $d ]] || die "DXMT is missing, run scripts/install-dxmt.sh first" ;;
    # DirectX 9 and 11 over Vulkan and MoltenVK (scripts/build-dxvk.sh)
    dxvk) [[ -d $d ]] || die "DXVK is missing, run scripts/build-dxvk.sh first" ;;
    # CodeWeavers switch wined3d on the Mac to Vulkan for DirectX 10/11 (CW HACK 18311); that
    # works with their MoltenVK (scripts/build-moltenvk.sh). WINE_D3D_CONFIG=renderer=gl
    # forces OpenGL.
    wined3d) ;;
  esac
  # default for programs without a rule; ntdll sets CX_ACTIVE_GRAPHICS_BACKEND per program
  export FREEQUAY_DEFAULT_BACKEND=$backend
  export CX_ACTIVE_GRAPHICS_BACKEND=${backend/d3dmetal3/d3dmetal}
  if [[ -n $d ]]; then export FREEQUAY_PRIORITY_DLLPATH=$d; else unset FREEQUAY_PRIORITY_DLLPATH; fi
  # offer every installed backend to the rules per program
  for b in d3dmetal d3dmetal3 dxmt dxvk; do
    d=$(backend_dir $b)
    [[ -d $d ]] || continue
    # D3DMetal's links to Wine's Unix libraries end nowhere after the app moved; make them again
    [[ -z $(print -l -- $d/x86_64-unix/*(N-@)) ]] || "$ROOT/scripts/link-backend.sh" "$d/x86_64-unix" > /dev/null
    export "FREEQUAY_BACKEND_$b=$d"
    backend_stubs "$dir" "$d"
  done
  export FREEQUAY_COMPAT_FILES="$(compat_files "$dir")"
  [[ $3 == 1 ]] && export ROSETTA_ADVERTISE_AVX=1
  [[ $4 == 1 ]] && export MTL_HUD_ENABLED=1
  return 0
}

# Wine only loads a builtin DLL when the bottle has a placeholder for it. DLLs that only the
# backend brings (winemetal.dll, nvapi64.dll ...) are copied in once; when loading, Wine then
# takes the version from the backend directory together with its Unix part.
backend_stubs() { # bottle-dir backend-dir
  local arch target f
  for arch target in x86_64 system32 i386 syswow64; do
    [[ -d "$1/drive_c/windows/$target" ]] || continue  # a new bottle gets them at its first run
    for f in "$2/$arch-windows"/*.dll(N); do
      [[ -e "$1/drive_c/windows/$target/${f:t:l}" || -e "$1/drive_c/windows/$target/${f:t}" ]] ||
        cp "$f" "$1/drive_c/windows/$target/${f:t:l}"
    done
  done
}

cmd=${1:-}; shift || true
case $cmd in
  new)
    dir=$(bottle_dir "${1:-}")
    [[ -e $dir ]] && die "bottle exists already: $dir"
    # Wine installs Wine Mono (.NET) silently from dist/wine/share/wine/mono or from CACHE/wine,
    # where the first new bottle downloads it from WineHQ. Gecko (HTML) stays off, otherwise Wine
    # asks for the download in a dialog.
    msi=($WINE_DIR/share/wine/mono/wine-mono-*-x86.msi(N) $CACHE/wine/wine-mono-*-x86.msi(N))
    (( $#msi )) || "$ROOT/scripts/install-mono.sh" ||
      print -u2 "freequay: Wine Mono is missing, .NET programs will not run in this bottle"
    mkdir -p "$dir"
    setup_env "$dir" wined3d 0 0 0
    msi=($WINE_DIR/share/wine/mono/wine-mono-*-x86.msi(N) $CACHE/wine/wine-mono-*-x86.msi(N))
    overrides="mshtml="; (( $#msi )) || overrides="mscoree,mshtml="
    WINEDLLOVERRIDES=$overrides "$WINE_DIR/bin/wine" wineboot --init
    "$WINE_DIR/bin/wineserver" --wait
    conf_set "$dir" backend dxmt
    conf_set "$dir" avx 0
    print -- "bottle created: $dir"
    ;;
  run|wine)
    dir=$(bottle_dir "${1:-}"); shift
    [[ -d $dir ]] || die "no bottle at $dir"
    backend=$(conf_get "$dir" backend dxmt); avx=$(conf_get "$dir" avx 0); hud=0; debug=0
    while [[ ${1:-} == --* ]]; do
      case $1 in
        --backend) backend=$2; shift 2 ;;
        --avx) avx=1; shift ;;
        --hud) hud=1; shift ;;
        --debug) debug=1; shift ;;
        *) die "unknown option: $1" ;;
      esac
    done
    [[ -n "${1:-}" ]] || die "program missing"
    # a Steam game gets its rules from AppleGamingWiki before it starts, the others in the background
    if [[ $cmd == run && $1 == steam:<-> ]]; then
      agw_lookup --quick ${1#steam:} || true
    elif [[ $cmd == run ]]; then
      agw_lookup --background $(steam_ids "$dir") || true
    fi
    # a Steam game by its ID: Steam starts it, and starts itself first if needed
    if [[ $cmd == run && $1 == steam:<-> ]]; then
      set -- "$dir/drive_c/Program Files (x86)/Steam/steam.exe" -applaunch "${1#steam:}" "${@:2}"
    fi
    # before Steam starts, catch up on the setup of installed games (freequay fix)
    if [[ $cmd == run && ${1:t:l} == steam.exe ]] && ! bottle_running "$dir"; then
      run_fix "$dir" || print -u2 "freequay: setup incomplete, starting Steam anyway"
    fi
    # while Steam runs, the games it installs get their rules
    [[ $cmd == run && ${1:t:l} == steam.exe ]] && agw_watch "$dir"
    setup_env "$dir" "$backend" "$avx" "$hud" "$debug"
    # Rosetta reads ROSETTA_ADVERTISE_AVX only at exec; for child processes ntdll sets it itself
    if [[ $cmd == run ]] && grep -qi -- "^exe:[^"$'\t'"]*${1:t}"$'\t'".*env=ROSETTA_ADVERTISE_AVX=1" \
        ${(s.:.)FREEQUAY_COMPAT_FILES} 2>/dev/null; then
      export ROSETTA_ADVERTISE_AVX=1
    fi
    if [[ $cmd == run && -f ${1:a} ]]; then
      # start from the program's directory, many games expect that
      exe=${1:a}; shift
      cd "${exe:h}"
      exec "$WINE_DIR/bin/wine" "$exe" "$@"
    fi
    exec "$WINE_DIR/bin/wine" "$@"
    ;;
  set)
    dir=$(bottle_dir "${1:-}")
    [[ -d $dir ]] || die "no bottle at $dir"
    [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: freequay set <bottle> <key> <value>"
    conf_set "$dir" "$2" "$3"
    ;;
  app)
    dir=$(bottle_dir "${1:-}")
    [[ -d $dir ]] || die "no bottle at $dir"
    if [[ -z "${2:-}" ]]; then
      print "rules of the bottle ($dir/compat.txt):"
      [[ -f $dir/compat.txt ]] && sed 's/^/  /' "$dir/compat.txt"
      print "rules from open sources: freequay info $1 <program.exe|steam:ID>"
      exit 0
    fi
    [[ -n "${3:-}" ]] || die "usage: freequay app <bottle> <program.exe|steam:ID> <backend|->"
    key=$(rule_key "$2")
    [[ $3 == - ]] || check_backend "$3"
    rule_del "$dir" "$key" backend
    [[ $3 == - ]] || print -r -- "$key"$'\t'"backend=$3" >> "$dir/compat.txt"
    ;;
  rule)
    dir=$(bottle_dir "${1:-}")
    [[ -d $dir ]] || die "no bottle at $dir"
    [[ -n "${2:-}" && -n "${3:-}" ]] || die "usage: freequay rule <bottle> <program.exe|steam:ID> <directive...|->"
    key=$(rule_key "$2"); shift 2
    if [[ $1 == - ]]; then rule_del "$dir" "$key"; exit 0; fi
    for d in "$@"; do
      [[ $d == (backend|env|dll|args|argdel|exe|verb|reg|winver|ini|note)=* && $d != *$'\t'* ]] ||
        die "unknown directive: $d"
      [[ $d != backend=* ]] || check_backend "${d#backend=}"
    done
    print -r -- "$key"$'\t'"${(pj:\t:)@}" >> "$dir/compat.txt"
    ;;
  info)
    if [[ -n "${2:-}" ]]; then dir=$(bottle_dir "$1"); shift; else dir=; fi
    [[ -n "${1:-}" ]] || die "usage: freequay info [<bottle>] <program.exe|steam:ID|title>"
    files=(); [[ -n $dir && -f $dir/compat.txt ]] && files+=("$dir/compat.txt")
    for f in $COMPAT_FILES; do [[ -f $f ]] && files+=("$f"); done
    notes=($AGW_DIR/notes.tsv(N) $COMPAT/notes.tsv(N)) titles=($COMPAT/titles.tsv(N) $AGW_DIR/titles.tsv(N))
    query=$1
    if [[ $query == <-> || $query == steam:<-> ]]; then
      ids=(${query#steam:})
    elif [[ $query == *.exe ]] || (( ! $#titles )); then
      ids=()
    else
      # title: Steam app IDs from titles.tsv in compat/ and from AppleGamingWiki, one title per ID
      found=$(awk -F'\t' '!/^#/ && !seen[$1]++' $titles | { grep -i -- "$query" || true; } | head -20)
      ids=(${(f)"$(print -r -- "$found" | cut -f1)"})
      [[ -z $found ]] || print -r -- "$found" | sed 's/^/  /'
    fi
    # grep often finds nothing; with pipefail that must not end the command
    for f in $files; do
      if (( $#ids )); then
        for id in $ids; do { grep -- "^steam:$id"$'\t' "$f" || true; } | sed "s|^|${f:t}: |"; done
      else
        { grep -i -- "^exe:[^"$'\t'"]*${query##*\\}"$'\t' "$f" || true; } | sed "s|^|${f:t}: |"
      fi
    done
    for id in $ids; do
      for f in $notes; do
        { grep -- "^steam:$id"$'\t' "$f" || true; } | cut -f2- | sed "s/^/  note steam:$id: /"
      done
    done
    ;;
  fix)
    dir=$(bottle_dir "${1:-}"); shift
    [[ -d $dir ]] || die "no bottle at $dir"
    run_fix "$dir" "$@"
    ;;
  kill)
    dir=$(bottle_dir "${1:-}")
    WINEPREFIX="$dir" "$WINE_DIR/bin/wineserver" -k || true
    ;;
  list)
    [[ -d $BOTTLES ]] && ls -1 "$BOTTLES" || true
    ;;
  applegamingwiki)
    case ${1:-} in
      --ids)  # in the background (agw_lookup)
        shift; agw_refresh; (( ! $# )) || agw_run "$@" || true ;;
      --watch)  # follows a bottle while it runs (agw_watch)
        dir=$(bottle_dir "${2:-}")
        pid=$AGW_DIR/applegamingwiki/watch-${dir:t}.pid
        print -r -- $$ > "$pid"
        for i in {1..60}; do bottle_running "$dir" && break; sleep 1; done
        while bottle_running "$dir"; do
          agw_lookup $(steam_ids "$dir") || true
          sleep 60
        done
        rm -f "$pid" ;;
      *)
        bottles=("$@"); (( $#bottles )) || bottles=($BOTTLES/*(N/:t))
        typeset -U ids=()
        for b in $bottles; do ids+=($(steam_ids "$(bottle_dir "$b")")); done
        (( $#ids )) || { print "no Steam games installed"; exit 0; }
        [[ -x $AGW ]] || die "$AGW is missing, build it with scripts/build-app.sh"
        agw_refresh
        due=($(agw_due $ids))
        (( $#due )) || { print "all $#ids games were looked up in the last week"; exit 0; }
        agw_run $due ;;
    esac
    ;;
  programs)
    # One line per program: its name, a tab and what run takes for it; first what the bottle has
    # (found_programs), then what was added. programs.txt in the bottle keeps the added programs
    # (add, tab, path) and the found ones taken off the list (hide, tab, run target).
    dir=$(bottle_dir "${1:-}")
    [[ -d $dir ]] || die "no bottle at $dir"
    agw_lookup --background $(steam_ids "$dir") || true
    list=$dir/programs.txt
    if [[ -n "${2:-}" ]]; then
      target=$2
      [[ $target == steam:<-> || $target == /* ]] || target=${target:a}
      [[ $target != *[$'\t\n']* ]] || die "invalid program: $target"
      touch "$list"
      if [[ ${3:-} == - ]]; then
        # an added program is forgotten, a found one hidden; no file is deleted
        line_del "$list" "add"$'\t'"$target"
        if found_programs "$dir" | cut -f2 | grep -xF -- "$target" > /dev/null; then
          grep -xF -- "hide"$'\t'"$target" "$list" > /dev/null || print -r -- "hide"$'\t'"$target" >> "$list"
        fi
      else
        [[ $target == steam:<-> || -f $target ]] || die "no program at $target"
        line_del "$list" "hide"$'\t'"$target"
        found_programs "$dir" | cut -f2 | grep -xF -- "$target" > /dev/null ||
          grep -xF -- "add"$'\t'"$target" "$list" > /dev/null || print -r -- "add"$'\t'"$target" >> "$list"
      fi
      exit 0
    fi
    {
      found_programs "$dir"
      if [[ -f $list ]]; then
        awk -F'\t' '$1 == "add" { print $2 }' "$list" | while IFS= read -r f; do
          if [[ -f $f ]]; then print -r -- "${f:t:r}"$'\t'"$f"; fi
        done | sort -f
      fi
    } | LIST=$list awk -F'\t' '
      BEGIN { while ((getline line < ENVIRON["LIST"]) > 0) { split(line, p, "\t"); if (p[1] == "hide") hidden[p[2]] = 1 } }
      !hidden[$2] && !seen[$2]++'
    ;;
  *)
    sed -n '/^set -e/q;2,$p' "$0" | sed 's/^# \{0,1\}//'
    [[ -z $cmd ]] || exit 1
    ;;
esac
