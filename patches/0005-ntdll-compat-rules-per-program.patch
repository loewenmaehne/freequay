+
+WINE_DEFAULT_DEBUG_CHANNEL(freequay);
+
+struct freequay_rules freequay_rules;
+
+static char lower( char c )
+{
+    if (c == '/') return '\\';
+    return (c >= 'A' && c <= 'Z') ? c + 'a' - 'A' : c;
+}
+
+/* does the program path end in key, at a path separator? */
+BOOL freequay_tail_match( const char *path, size_t path_len, const char *key, size_t key_len )
+{
+    size_t i;
+
+    if (!key_len || key_len > path_len) return FALSE;
+    for (i = 0; i < key_len; i++)
+        if (lower( path[path_len - key_len + i] ) != lower( key[i] )) return FALSE;
+    if (lower( key[0] ) == '\\' || path_len == key_len) return TRUE;
+    return lower( path[path_len - key_len - 1] ) == '\\' || path[path_len - key_len - 1] == ':';
+}
+
+static char *strndup_( const char *str, size_t len )
+{
+    char *ret = malloc( len + 1 );
+    if (!ret) return NULL;
+    memcpy( ret, str, len );
+    ret[len] = 0;
+    return ret;
+}
+
+/* add NAME=value to a list unless NAME is already there */
+static void add_named( char **list, unsigned int *count, const char *str, size_t len )
+{
+    const char *eq = memchr( str, '=', len );
+    size_t name_len = eq ? eq - str : len;
+    unsigned int i;
+
+    if (!name_len || *count >= FREEQUAY_MAX_ENTRIES) return;
+    for (i = 0; i < *count; i++)
+        if (!strncasecmp( list[i], str, name_len ) && list[i][name_len] == '=') return;
+    list[(*count)++] = strndup_( str, len );
+}
+
+static void add_directive( const char *dir, size_t len, BOOL steam )
+{
+    struct freequay_rules *r = &freequay_rules;
+
+#define IS(name) (len >= sizeof(name) - 1 && !memcmp( dir, name, sizeof(name) - 1 ))
+    if (IS( "backend=" ))
+    {
+        if (!r->backend) r->backend = strndup_( dir + 8, len - 8 );
+    }
+    else if (IS( "env=" )) add_named( r->env, &r->env_count, dir + 4, len - 4 );
+    else if (IS( "dll=" )) add_named( r->dll, &r->dll_count, dir + 4, len - 4 );
+    else if (IS( "args=" ))
+    {
+        if (!r->args)
+        {
+            r->args = strndup_( dir + 5, len - 5 );
+            r->args_steam = steam;
+        }
+    }
+    else if (IS( "argdel=" ))
+    {
+        if (r->argdel_count < FREEQUAY_MAX_ENTRIES && len > 7)
+        {
+            r->argdel[r->argdel_count++] = strndup_( dir + 7, len - 7 );
+            if (steam) r->argdel_steam = TRUE;
+        }
+    }
+    else if (IS( "exe=" ))
+    {
+        if (!r->exe && memchr( dir, '>', len ))
+        {
+            r->exe = strndup_( dir + 4, len - 4 );
+            r->exe_steam = steam;
+        }
+    }
+#undef IS
+}
+
+static char *read_file( const char *name, size_t *size )
+{
+    char *buf = NULL, *tmp;
+    size_t alloc = 0;
+    ssize_t ret;
+    int fd;
+
+    *size = 0;
+    if ((fd = open( name, O_RDONLY )) == -1) return NULL;
+    for (;;)
+    {
+        if (*size + 65536 > alloc)
+        {
+            alloc = alloc ? alloc * 2 : 262144;
+            if (!(tmp = realloc( buf, alloc + 1 ))) break;
+            buf = tmp;
+        }
+        if ((ret = read( fd, buf + *size, alloc - *size )) <= 0) break;
+        *size += ret;
+    }
+    close( fd );
+    if (buf) buf[*size] = 0;
+    return buf;
+}
+
+static void scan_file( const char *name, const char *image, size_t image_len, const char *steam_id )
+{
+    size_t size, id_len = steam_id ? strlen( steam_id ) : 0;
+    char *buf = read_file( name, &size ), *line, *next, *end, *tab, *dir;
+    BOOL steam;
+
+    if (!buf) return;
+    for (line = buf; line < buf + size; line = next)
+    {
+        if (!(end = memchr( line, '\n', buf + size - line ))) end = buf + size;
+        next = end + 1;
+        if (end > line && end[-1] == '\r') end--;
+        if (line == end || *line == '#' || !(tab = memchr( line, '\t', end - line ))) continue;
+
+        if (tab - line > 6 && !memcmp( line, "steam:", 6 ))
+        {
+            if (!id_len || (size_t)(tab - line - 6) != id_len || memcmp( line + 6, steam_id, id_len )) continue;
+            steam = TRUE;
+        }
+        else if (tab - line > 4 && !memcmp( line, "exe:", 4 ))
+        {
+            if (!freequay_tail_match( image, image_len, line + 4, tab - line - 4 )) continue;
+            steam = FALSE;
+        }
+        else continue;
+
+        for (dir = tab + 1; dir < end; dir = tab + 1)
+        {
+            if (!(tab = memchr( dir, '\t', end - dir ))) tab = end;
+            if (tab > dir) add_directive( dir, tab - dir, steam );
+        }
+        freequay_rules.matched = TRUE;
+    }
+    free( buf );
+}
+
+/***********************************************************************
+ *           freequay_init_rules
+ *
+ * Collect the rules for the program at image (Unix or NT path); steam_id may be NULL.
+ */
+BOOL freequay_init_rules( const char *image, const char *steam_id )
+{
+    const char *files = getenv( "FREEQUAY_COMPAT_FILES" ), *p, *colon;
+    char *name;
+
+    memset( &freequay_rules, 0, sizeof(freequay_rules) );  /* a forked process starts over */
+    if (!files || !image) return FALSE;
+    for (p = files; *p; p = *colon ? colon + 1 : colon)
+    {
+        if (!(colon = strchr( p, ':' ))) colon = p + strlen( p );
+        if (colon == p || !(name = strndup_( p, colon - p ))) continue;
+        scan_file( name, image, strlen( image ), steam_id );
+        free( name );
+    }
+    if (freequay_rules.matched)
+        TRACE( "%s (steam %s): backend %s, %u env, %u dll, args %s, exe %s\n", debugstr_a(image),
+               debugstr_a(steam_id), debugstr_a(freequay_rules.backend), freequay_rules.env_count,
+               freequay_rules.dll_count, debugstr_a(freequay_rules.args), debugstr_a(freequay_rules.exe) );
+    return freequay_rules.matched;
+}
