+/* set a variable in the Windows environment being built (if any) and the Unix one */
+static void freequay_set_env( WCHAR **env, SIZE_T *pos, SIZE_T *size, const char *name, const char *value )
+{
+    SIZE_T name_len = strlen( name ) + 1, value_len = value ? strlen( value ) + 1 : 0;
+    WCHAR *nameW = malloc( name_len * sizeof(WCHAR) ), *valueW = value ? malloc( value_len * sizeof(WCHAR) ) : NULL;
 
+    if (env && nameW && (valueW || !value))
+    {
+        ntdll_umbstowcs( name, name_len, nameW, name_len );
+        if (value) ntdll_umbstowcs( value, value_len, valueW, value_len );
+        set_env_var( env, pos, size, nameW, wcslen( nameW ), valueW );
+    }
+    free( nameW );
+    free( valueW );
+    if (value) setenv( name, value, 1 );
+    else unsetenv( name );
+}
 
+static char *freequay_get_env( WCHAR *env, SIZE_T pos, const WCHAR *name )
+{
+    WCHAR *value = get_env_var( env, pos, name, wcslen( name ) );
+    SIZE_T len;
+    char *ret;
+
+    if (!value) return NULL;
+    len = wcslen( value ) + 1;
+    if ((ret = malloc( len * 3 ))) ntdll_wcstoumbs( value, len, ret, len * 3, FALSE );
+    free( value );
+    return ret;
+}
+
+static void freequay_apply_env( WCHAR **env, SIZE_T *pos, SIZE_T *size )
+{
+    struct freequay_rules *r = &freequay_rules;
+    char *eq, *overrides, *old = getenv( "WINEDLLOVERRIDES" );
+    size_t len = old ? strlen( old ) + 2 : 1;
+    unsigned int i;
+
+    for (i = 0; i < r->env_count; i++)
+    {
+        if (!(eq = strchr( r->env[i], '=' ))) continue;
+        *eq = 0;
+        freequay_set_env( env, pos, size, r->env[i], eq[1] ? eq + 1 : NULL );
+        *eq = '=';
+    }
+    if (!r->dll_count) return;
+    for (i = 0; i < r->dll_count; i++) len += strlen( r->dll[i] ) + 1;
+    if (!(overrides = malloc( len ))) return;
+    for (i = 0, *overrides = 0; i < r->dll_count; i++)
+    {
+        if (i) strcat( overrides, ";" );
+        strcat( overrides, r->dll[i] );
+    }
+    if (old && *old)
+    {
+        strcat( overrides, ";" );
+        strcat( overrides, old );
+    }
+    freequay_set_env( env, pos, size, "WINEDLLOVERRIDES", overrides );
+    free( overrides );
+}
+
+/* is this the program Steam started for the game, and not an installer, crash handler or a
+ * program the game started itself? */
+static BOOL freequay_is_steam_game( const char *image, WCHAR *env, SIZE_T pos )
+{
+    static const char * const skip[] =
+    {
+        "\\_commonredist\\", "\\commonredist\\", "\\redist\\", "\\redistributables\\", "\\__installer\\",
+        "\\directx\\", "\\steamworks shared\\", "\\easyanticheat", "\\battleye\\", "crashhandler",
+        "crashreport", "crashpad", "bssndrpt", "\\unins",
+    };
+    char *path;
+    BOOL ret;
+    size_t i;
+
+    if (getenv( "FREEQUAY_STEAM_LAUNCH" ) || (env && find_env_var( env, pos, freequay_launchW, wcslen( freequay_launchW ) )))
+        return FALSE;
+    if (!(path = strdup( image ))) return FALSE;
+    for (i = 0; path[i]; i++)
+    {
+        if (path[i] == '/') path[i] = '\\';
+        else if (path[i] >= 'A' && path[i] <= 'Z') path[i] += 'a' - 'A';
+    }
+    ret = strstr( path, "\\steamapps\\common\\" ) != NULL;
+    for (i = 0; ret && i < ARRAY_SIZE(skip); i++) if (strstr( path, skip[i] )) ret = FALSE;
+    free( path );
+    return ret;
+}
