+/* rules for a program started by another one; returns replacements for image and command line */
+static void freequay_child_rules( const struct startup_info_data *info, WCHAR **env, SIZE_T *pos, SIZE_T *size,
+                                  WCHAR **image_ret, WCHAR **cmdline_ret )
+{
+    const WCHAR *image = (const WCHAR *)((const char *)(info + 1) + info->curdir_len + info->dllpath_len);
+    SIZE_T len = info->imagepath_len / sizeof(WCHAR);
+    char *image_a, *steam_id;
+    WCHAR *nt_path;
+
+    *image_ret = *cmdline_ret = NULL;
+    if (!getenv( "FREEQUAY_COMPAT_FILES" ) || !(image_a = malloc( len * 3 + 1 ))) return;
+    image_a[ntdll_wcstoumbs( image, len, image_a, len * 3, FALSE )] = 0;
+    if (!(steam_id = freequay_get_env( *env, *pos, steamappidW ))) steam_id = freequay_get_env( *env, *pos, steamgameidW );
+    if (freequay_init_rules( image_a, steam_id ))
+    {
+        freequay_apply_env( env, pos, size );
+        *cmdline_ret = freequay_edit_cmdline( image + len, info->cmdline_len / sizeof(WCHAR), image_a, steam_id,
+                                              env, pos, size, image_ret );
+    }
+    /* the program that starts: the one from exe= or the image path, both NT paths */
+    nt_path = *image_ret ? NULL : freequay_to_wide( image_a );
+    freequay_apply_backend( *image_ret ? *image_ret : nt_path, env, pos, size );
+    free( nt_path );
+    free( image_a );
+    free( steam_id );
+}
+
+/* Called in the forked process right before it executes the new program: environment rules
+ * also go into its Unix environment, for variables read before ntdll runs (ROSETTA_ADVERTISE_AVX
+ * is read by Rosetta when the program starts). */
+void freequay_spawn_env( const RTL_USER_PROCESS_PARAMETERS *params )
+{
+    SIZE_T len = params->ImagePathName.Length / sizeof(WCHAR), env_len = 0;
+    char *image, *steam_id;
+    unsigned int i;
+    char *eq;
+
+    if (!getenv( "FREEQUAY_COMPAT_FILES" ) || !params->Environment || !(image = malloc( len * 3 + 1 ))) return;
+    image[ntdll_wcstoumbs( params->ImagePathName.Buffer, len, image, len * 3, FALSE )] = 0;
+    while (params->Environment[env_len]) env_len += wcslen( params->Environment + env_len ) + 1;
+    if (!(steam_id = freequay_get_env( params->Environment, env_len, steamappidW )))
+        steam_id = freequay_get_env( params->Environment, env_len, steamgameidW );
+    if (freequay_init_rules( image, steam_id ))
+    {
+        for (i = 0; i < freequay_rules.env_count; i++)
+        {
+            if (!(eq = strchr( freequay_rules.env[i], '=' ))) continue;
+            *eq = 0;
+            if (eq[1]) setenv( freequay_rules.env[i], eq + 1, 1 );
+            else unsetenv( freequay_rules.env[i] );
+            *eq = '=';
+        }
+    }
+    free( image );
+    free( steam_id );
+}
