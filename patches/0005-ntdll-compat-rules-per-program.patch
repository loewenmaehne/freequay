+/* freequay: compatibility rules per program (freequay.c). They are applied while the process
+ * parameters are built, before the main exe and any DLL are loaded. */
+
+static const WCHAR steamappidW[] = {'S','t','e','a','m','A','p','p','I','d',0};
+static const WCHAR steamgameidW[] = {'S','t','e','a','m','G','a','m','e','I','d',0};
+static const WCHAR freequay_launchW[] = {'F','R','E','E','Q','U','A','Y','_','S','T','E','A','M','_','L','A','U','N','C','H',0};
