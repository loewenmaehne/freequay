+/* Backend for a program without a backend rule that imports d3d12.dll, or NULL. dxmt and dxvk
+ * have no Direct3D 12, and Wine's d3d12 does not work with their dxgi. A 64-bit program gets
+ * D3DMetal when it is installed, otherwise wined3d, where Wine's d3d12 runs on vkd3d. Without
+ * D3DMetal, a program that imports d3d11.dll as well keeps dxmt or dxvk: Unreal Engine games
+ * import both and most of them run on Direct3D 11. */
+static const char *freequay_d3d12_backend( const WCHAR *nt_path )
+{
+    const char *def = getenv( "FREEQUAY_DEFAULT_BACKEND" ), *dir;
+    unsigned int d3d;
+    USHORT machine;
+
+    if (!def || (strcmp( def, "dxmt" ) && strcmp( def, "dxvk" ))) return NULL;
+    machine = freequay_pe_info( nt_path, &d3d );
+    if (!(d3d & FREEQUAY_D3D12)) return NULL;
+    if (machine == IMAGE_FILE_MACHINE_AMD64)
+    {
+        if ((dir = getenv( "FREEQUAY_BACKEND_d3dmetal" )) && *dir) return "d3dmetal";
+        if ((dir = getenv( "FREEQUAY_BACKEND_d3dmetal3" )) && *dir) return "d3dmetal3";
+    }
+    return (d3d & FREEQUAY_D3D11) ? NULL : "wined3d";
+}
+
+/* graphics backend of the program at nt_path: the one from its rule, else freequay_d3d12_backend */
+static void freequay_apply_backend( const WCHAR *nt_path, WCHAR **env, SIZE_T *pos, SIZE_T *size )
+{
+    const char *name = freequay_rules.backend;
+
+    if (!name || !freequay_set_backend( name ))
+    {
+        if (!nt_path || !(name = freequay_d3d12_backend( nt_path ))) return;
+        TRACE_(freequay)( "%s imports d3d12.dll: backend %s\n", debugstr_w(nt_path), name );
+        freequay_set_backend( name );
+    }
+    freequay_set_env( env, pos, size, "CX_ACTIVE_GRAPHICS_BACKEND", getenv( "CX_ACTIVE_GRAPHICS_BACKEND" ) );
+}
+
+static WCHAR *freequay_to_wide( const char *str )
+{
+    SIZE_T len = strlen( str ) + 1;
+    WCHAR *ret = malloc( len * sizeof(WCHAR) );
+
+    if (ret) ntdll_umbstowcs( str, len, ret, len );
+    return ret;
+}
+
+/* exe=<from>><to>: path of the program to start instead, as an NT path, or NULL */
+static WCHAR *freequay_replace_exe( const char *image )
+{
+    const char *rule = freequay_rules.exe, *gt = strchr( rule, '>' );
+    size_t image_len = strlen( image ), from_len = gt - rule, base;
+    char *path, *p, *q;
+    WCHAR *orig, *ret;
+    USHORT machine;
+
+    if (!freequay_tail_match( image, image_len, rule, from_len ) || strncmp( image, "\\??\\", 4 )) return NULL;
+    base = image_len - from_len;
+    if (!(path = malloc( base + strlen( gt + 1 ) + 2 ))) return NULL;
+    memcpy( path, image, base );
+    if (base && image[base - 1] != '\\') path[base++] = '\\';
+    strcpy( path + base, gt + 1 + (gt[1] == '\\' || gt[1] == '/') );
+    for (p = path; *p; p++) if (*p == '/') *p = '\\';
+    /* resolve . and .. after the \??\X:\ prefix */
+    for (p = path + 7; (q = strstr( p - 1, "\\.\\" )); ) memmove( q, q + 2, strlen( q + 2 ) + 1 );
+    while ((q = strstr( path + 6, "\\..\\" )))
+    {
+        for (p = q - 1; p > path + 6 && *p != '\\'; p--) ;
+        memmove( p, q + 3, strlen( q + 3 ) + 1 );
+    }
+    ret = freequay_to_wide( path );
+    orig = freequay_to_wide( image );
+    machine = ret && orig ? freequay_pe_info( orig, NULL ) : 0;
+    if (!machine || freequay_pe_info( ret, NULL ) != machine)
+    {
+        WARN_(freequay)( "not starting %s instead of %s\n", debugstr_a(path), debugstr_a(image) );
+        free( ret );
+        ret = NULL;
+    }
+    free( orig );
+    free( path );
+    return ret;
+}
+
+/* args=, argdel= and exe=; returns the new command line or NULL, *image_ret the new program */
+static WCHAR *freequay_edit_cmdline( const WCHAR *cmdline, SIZE_T len, const char *image, const char *steam_id,
+                                     WCHAR **env, SIZE_T *pos, SIZE_T *size, WCHAR **image_ret )
+{
+    struct freequay_rules *r = &freequay_rules;
+    BOOL steam_game, changed = FALSE;
+    char *cmd, *tmp, *hit, *end;
+    unsigned int i;
+    size_t n;
+    WCHAR *ret;
+
+    if (image_ret) *image_ret = NULL;
+    if (!r->args && !r->argdel_count && !r->exe) return NULL;
+    steam_game = steam_id && freequay_is_steam_game( image, env ? *env : NULL, pos ? *pos : 0 );
+    if (!(cmd = malloc( len * 3 + 1 ))) return NULL;
+    cmd[ntdll_wcstoumbs( cmdline, len, cmd, len * 3, FALSE )] = 0;
+
+    if (r->exe && image_ret && (!r->exe_steam || steam_game) && (*image_ret = freequay_replace_exe( image )))
+    {
+        /* the new program also becomes the first word of the command line */
+        end = cmd[0] == '"' ? strchr( cmd + 1, '"' ) : strchr( cmd, ' ' );
+        end = end ? end + (cmd[0] == '"') : cmd + strlen( cmd );
+        n = wcslen( *image_ret ) * 3 + strlen( end ) + 3;
+        if ((tmp = malloc( n )))
+        {
+            tmp[0] = '"';
+            n = ntdll_wcstoumbs( *image_ret + 4, wcslen( *image_ret ) - 4, tmp + 1, n, FALSE ) + 1;
+            tmp[n++] = '"';
+            strcpy( tmp + n, end );
+            free( cmd );
+            cmd = tmp;
+            changed = TRUE;
+        }
+    }
+    for (i = 0; i < r->argdel_count && (!r->argdel_steam || steam_game); i++)
+    {
+        n = strlen( r->argdel[i] );
+        for (hit = cmd; (hit = strstr( hit + 1, r->argdel[i] )); )
+        {
+            if (hit[-1] != ' ' || (hit[n] && hit[n] != ' ')) continue;
+            memmove( hit - 1, hit + n, strlen( hit + n ) + 1 );
+            changed = TRUE;
+            hit--;
+        }
+    }
+    if (r->args && *r->args && (!r->args_steam || steam_game) && !strstr( cmd, r->args ) &&
+        (tmp = realloc( cmd, strlen( cmd ) + strlen( r->args ) + 2 )))
+    {
+        cmd = tmp;
+        strcat( cmd, " " );
+        strcat( cmd, r->args );
+        changed = TRUE;
+    }
+    if (steam_game && (r->args_steam || r->argdel_steam || r->exe_steam))
+        freequay_set_env( env, pos, size, "FREEQUAY_STEAM_LAUNCH", steam_id );
+
+    ret = changed ? freequay_to_wide( cmd ) : NULL;
+    if (ret) TRACE_(freequay)( "command line %s\n", debugstr_a(cmd) );
+    free( cmd );
+    return ret;
+}
