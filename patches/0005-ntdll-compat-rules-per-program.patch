+#define FREEQUAY_D3D11 1
+#define FREEQUAY_D3D12 2
+
+/* file offset of the data at an RVA, -1 if the file has none there */
+static off_t freequay_rva_offset( const IMAGE_SECTION_HEADER *sec, unsigned int count, DWORD rva )
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+        if (rva >= sec[i].VirtualAddress && rva - sec[i].VirtualAddress < sec[i].SizeOfRawData)
+            return (off_t)sec[i].PointerToRawData + rva - sec[i].VirtualAddress;
+    return -1;
+}
+
+/* machine of a PE file, 0 if it is none; with d3d, also which of d3d11.dll and d3d12.dll it
+ * imports, directly or delay-loaded (FREEQUAY_D3D11, FREEQUAY_D3D12) */
+static USHORT freequay_pe_info( const WCHAR *nt_path, unsigned int *d3d )
+{
+    static const struct { unsigned int dir, size, name; } tables[] =
+    {
+        { IMAGE_DIRECTORY_ENTRY_IMPORT, sizeof(IMAGE_IMPORT_DESCRIPTOR), offsetof(IMAGE_IMPORT_DESCRIPTOR, Name) },
+        { IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT, sizeof(IMAGE_DELAYLOAD_DESCRIPTOR), offsetof(IMAGE_DELAYLOAD_DESCRIPTOR, DllNameRVA) },
+    };
+    UNICODE_STRING nt_name, true_nt_name;
+    OBJECT_ATTRIBUTES attr;
+    IMAGE_DOS_HEADER dos;
+    union { IMAGE_NT_HEADERS32 h32; IMAGE_NT_HEADERS64 h64; } nt;
+    IMAGE_SECTION_HEADER sec[96];
+    const IMAGE_DATA_DIRECTORY *dirs;
+    unsigned int i, j, k, count, nsec;
+    char *unix_name, name[16];
+    USHORT ret = 0;
+    ssize_t len;
+    DWORD rva;
+    off_t off;
+    int fd;
+
+    if (d3d) *d3d = 0;
+    init_unicode_string( &nt_name, nt_path );
+    InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (get_nt_and_unix_names( &attr, &true_nt_name, &unix_name, FILE_OPEN, FALSE )) return 0;
+    fd = open( unix_name, O_RDONLY );
+    free( unix_name );
+    free( true_nt_name.Buffer );
+    if (fd == -1) return 0;
+
+    if (pread( fd, &dos, sizeof(dos), 0 ) != sizeof(dos) || dos.e_magic != IMAGE_DOS_SIGNATURE ||
+        (len = pread( fd, &nt, sizeof(nt), dos.e_lfanew )) < (ssize_t)offsetof(IMAGE_NT_HEADERS32, OptionalHeader) ||
+        nt.h32.Signature != IMAGE_NT_SIGNATURE)
+        goto done;
+    ret = nt.h32.FileHeader.Machine;
+    if (!d3d) goto done;
+
+    if (nt.h32.OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR32_MAGIC && len >= (ssize_t)sizeof(nt.h32))
+    {
+        count = nt.h32.OptionalHeader.NumberOfRvaAndSizes;
+        dirs = nt.h32.OptionalHeader.DataDirectory;
+    }
+    else if (nt.h64.OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC && len >= (ssize_t)sizeof(nt.h64))
+    {
+        count = nt.h64.OptionalHeader.NumberOfRvaAndSizes;
+        dirs = nt.h64.OptionalHeader.DataDirectory;
+    }
+    else goto done;
+    nsec = min( nt.h32.FileHeader.NumberOfSections, ARRAY_SIZE(sec) );
+    len = pread( fd, sec, nsec * sizeof(sec[0]), dos.e_lfanew + offsetof(IMAGE_NT_HEADERS32, OptionalHeader) +
+                 nt.h32.FileHeader.SizeOfOptionalHeader );
+    nsec = len > 0 ? len / sizeof(sec[0]) : 0;
+
+    /* the descriptors end with one without a name */
+    for (i = 0; i < ARRAY_SIZE(tables); i++)
+    {
+        if (tables[i].dir >= count || !dirs[tables[i].dir].VirtualAddress) continue;
+        for (j = 0; j < 1024; j++)
+        {
+            off = freequay_rva_offset( sec, nsec, dirs[tables[i].dir].VirtualAddress + j * tables[i].size + tables[i].name );
+            if (off == -1 || pread( fd, &rva, sizeof(rva), off ) != sizeof(rva) || !rva) break;
+            if ((off = freequay_rva_offset( sec, nsec, rva )) == -1 ||
+                (len = pread( fd, name, sizeof(name) - 1, off )) <= 0) continue;
+            name[len] = 0;
+            for (k = 0; name[k]; k++) if (name[k] >= 'A' && name[k] <= 'Z') name[k] += 'a' - 'A';
+            if (!strcmp( name, "d3d11.dll" )) *d3d |= FREEQUAY_D3D11;
+            else if (!strcmp( name, "d3d12.dll" )) *d3d |= FREEQUAY_D3D12;
+        }
+    }
+done:
+    close( fd );
+    return ret;
+}
