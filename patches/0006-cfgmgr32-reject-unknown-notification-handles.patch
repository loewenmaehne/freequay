+static struct list cm_notify_contexts = LIST_INIT( cm_notify_contexts );
+static CRITICAL_SECTION cm_notify_cs;
+static CRITICAL_SECTION_DEBUG cm_notify_cs_debug =
+{
+    0, 0, &cm_notify_cs,
+    { &cm_notify_cs_debug.ProcessLocksList, &cm_notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": cm_notify_cs") }
+};
+static CRITICAL_SECTION cm_notify_cs = { &cm_notify_cs_debug, -1, 0, 0, 0, 0 };
