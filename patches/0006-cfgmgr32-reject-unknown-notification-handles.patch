+        list_remove( &ctx->entry );
+        LeaveCriticalSection( &cm_notify_cs );
+        I_ScUnregisterDeviceNotification( ctx->notify );
+        free( ctx );
+        return CR_SUCCESS;
+    }
+    LeaveCriticalSection( &cm_notify_cs );
 
