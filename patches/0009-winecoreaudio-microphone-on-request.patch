+/* freequay: a program sees the Mac's microphones only when FREEQUAY_MICROPHONE=1 is in its
+ * environment, which a rule sets for that one program (env=FREEQUAY_MICROPHONE=1,
+ * compat/README.md). Without it Wine lists no capture device and opens none, whoever started
+ * the program and whatever macOS would allow. Sound output is not affected. */
+static BOOL microphone_allowed(void)
+{
+    const char *value = getenv("FREEQUAY_MICROPHONE");
+
+    return value && !strcmp(value, "1");
+}
