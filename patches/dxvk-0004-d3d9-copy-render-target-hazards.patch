+  bool D3D9DeviceEx::CanCopyRenderHazards() {
+    if (!m_d3d9Options.copyRenderTargetHazards)
+      return false;
+
+    for (uint32_t rtIdx : bit::BitMask(m_activeHazardsRT)) {
+      if (!m_state.renderTargets[rtIdx]->GetCommonTexture()->CanCopyForHazard())
+        return false;
     }
+
+    return true;
   }
 
 
+  void D3D9DeviceEx::CopyRenderTargetHazards() {
+    // Copy every render target this draw also samples, and let the draw sample the copy.
+    // The next draw binds the texture itself again.
+    for (uint32_t rtIdx : bit::BitMask(m_activeHazardsRT)) {
+      D3D9Surface* rtSurf = m_state.renderTargets[rtIdx].ptr();
+      D3D9CommonTexture* tex = rtSurf->GetCommonTexture();
+      bool copied = false;
+
+      for (uint32_t samplerIdx : bit::BitMask(m_psShaderMasks.samplerMask & m_activeRTTextures)) {
+        if (m_state.textures[samplerIdx] != rtSurf->GetBaseTexture())
+          continue;
+
+        auto shaderSampler = RemapStateSamplerShader(samplerIdx);
+        uint32_t slot = computeResourceSlotId(shaderSampler.first,
+          DxsoBindingType::Image, uint32_t(shaderSampler.second));
+        const bool srgb = m_state.samplerStates[samplerIdx][D3DSAMP_SRGBTEXTURE] & 0x1;
+
+        EmitCs([
+          cCopy    = copied ? nullptr : tex->GetHazardCopy(),
+          cSrc     = tex->GetImage(),
+          cExtent  = tex->GetImage()->mipLevelExtent(0),
+          cSlot    = slot,
+          cView    = tex->GetHazardCopyView(srgb)
+        ] (DxvkContext* ctx) {
+          if (cCopy != nullptr) {
+            VkImageSubresourceLayers layers = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+            ctx->copyImage(cCopy, layers, VkOffset3D { 0, 0, 0 },
+                           cSrc, layers, VkOffset3D { 0, 0, 0 }, cExtent);
+          }
+          ctx->bindResourceView(cSlot, cView, nullptr);
+        });
+
+        copied = true;
+        m_dirtyTextures |= 1u << samplerIdx;
+      }
+    }
+  }
