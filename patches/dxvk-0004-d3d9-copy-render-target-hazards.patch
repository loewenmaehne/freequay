+  const Rc<DxvkImage>& D3D9CommonTexture::GetHazardCopy() {
+    if (likely(m_hazardCopy != nullptr))
+      return m_hazardCopy;
 
+    const Rc<DxvkDevice>& device = m_device->GetDXVKDevice();
 
+    DxvkImageCreateInfo info = m_image->info();
+    info.mipLevels     = 1;
+    info.usage         = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.stages        = VK_PIPELINE_STAGE_TRANSFER_BIT | device->getShaderPipelineStages();
+    info.access        = VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+    info.tiling        = VK_IMAGE_TILING_OPTIMAL;
+    info.layout        = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    info.shared        = VK_FALSE;
+    m_hazardCopy = device->createImage(info, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+
+    DxvkImageViewCreateInfo viewInfo = m_sampleView.Color->info();
+    viewInfo.minLevel  = 0;
+    viewInfo.numLevels = 1;
+    m_hazardCopyView.Color = device->createImageView(m_hazardCopy, viewInfo);
+
+    if (m_sampleView.Srgb != nullptr) {
+      viewInfo = m_sampleView.Srgb->info();
+      viewInfo.minLevel  = 0;
+      viewInfo.numLevels = 1;
+      m_hazardCopyView.Srgb = device->createImageView(m_hazardCopy, viewInfo);
+    }
+
+    return m_hazardCopy;
+  }
