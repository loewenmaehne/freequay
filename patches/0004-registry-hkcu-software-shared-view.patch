+/* freequay: HKCU\Software is shared between the 32- and 64-bit views since Windows 7, even when
+ * an application creates a Wow6432Node below it, as Steam does. Redirecting into that node hid
+ * HKCU\Software\Valve from 64-bit games that ask for the 32-bit view (steam_api64). */
+static BOOL is_user_software_key( HANDLE key )
+{
+    char buffer[256];
+    KEY_NAME_INFORMATION *info = (KEY_NAME_INFORMATION *)buffer;
+    DWORD len = sizeof(buffer), count;
+    const WCHAR *name, *p;
+
+    if (NtQueryKey( key, KeyNameInformation, info, len, &len )) return FALSE;
+    name = info->Name;
+    count = info->NameLength / sizeof(WCHAR);
+    if (count <= 15 || wcsnicmp( name, L"\\Registry\\User\\", 15 )) return FALSE;
+    for (p = name + 15; p < name + count && *p != '\\'; p++) ;
+    return name + count - p == 9 && !wcsnicmp( p, L"\\Software", 9 );
+}
