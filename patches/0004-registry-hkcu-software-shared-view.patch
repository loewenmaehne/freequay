+/* freequay: HKCU\Software is shared between the 32- and 64-bit views since Windows 7, even when
+ * an application creates a Wow6432Node below it, as Steam does. Redirecting into that node hid
+ * HKCU\Software\Valve from games that ask for the 32-bit view. */
+static int is_user_software_key( const struct key *key )
+{
+    static const WCHAR softwareW[] = {'S','o','f','t','w','a','r','e'};
+    static const WCHAR userW[] = {'U','s','e','r'};
+    const struct key *sid, *user, *root;
+
+    if (!key->obj.name || key->obj.name->len != sizeof(softwareW) ||
+        memicmp_strW( key->obj.name->name, softwareW, sizeof(softwareW) )) return 0;
+    if (!(sid = get_parent( key )) || !(user = get_parent( sid )) || !(root = get_parent( user ))) return 0;
+    return user->obj.name->len == sizeof(userW) && !memicmp_strW( user->obj.name->name, userW, sizeof(userW) ) &&
+           !get_parent( root );
+}
